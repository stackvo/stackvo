{
  "name": "stackvo-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Native desktop app for StackVo — Docker-based local development environment manager",
  "license": "MIT",
  "author": "Fahrettin Aksoy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stackvo/stackvo.git"
  },
  "bugs": {
    "url": "https://github.com/stackvo/stackvo/issues"
  },
  "homepage": "https://github.com/stackvo/stackvo#readme",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run sidecars:release && tauri build",
    "app": "tauri dev",
    "app:build": "npm run sidecars:release && tauri build",
    "dev:kill": "lsof -ti tcp:1420 | xargs kill 2>/dev/null || true",
    "test": "npm run sidecars:stubs && npm run test:js && cargo test --manifest-path src-tauri/Cargo.toml",
    "diagnose": "cargo run --manifest-path src-tauri/Cargo.toml --example diagnose",
    "contracts:check": "node tools/validate-contracts.mjs --allow-no-manifests",
    "env:usage": "node tools/measure-env-usage.mjs",
    "env:usage:fix": "node tools/measure-env-usage.mjs --fix && prettier --write contracts/env.schema.json",
    "legacy:rehearse": "node tools/legacy-deletion-rehearsal.mjs",
    "test:js": "vitest run",
    "test:js:watch": "vitest",
    "test:js:coverage": "vitest run --coverage",
    "screenshots": "node tools/screenshots.mjs",
    "a11y:transcript": "vitest run tests/a11y-transcript.spec.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:driver": "node --test tests/driver/boot.driver.js",
    "test:rs:coverage": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --summary-only && cargo llvm-cov report --manifest-path src-tauri/Cargo.toml --json --summary-only > rust-coverage.json && node tools/check-coverage.mjs --rust",
    "coverage:floors": "node tools/check-coverage.mjs",
    "updates:check": "node tools/check-updater-endpoint.mjs",
    "installers:check": "node tools/check-installers.mjs",
    "bundle:budget": "node tools/check-bundle.mjs",
    "types": "node tools/generate-types.mjs",
    "types:check": "node tools/generate-types.mjs --check",
    "types:report": "node tools/generate-types.mjs --report",
    "sidecars": "node tools/sidecars.mjs",
    "sidecars:release": "node tools/sidecars.mjs --release",
    "sidecars:stubs": "node tools/sidecars.mjs --stubs",
    "notice": "node tools/generate-notice.mjs",
    "notice:check": "node tools/generate-notice.mjs --check",
    "lint": "eslint . && prettier --check \"src/**/*.{js,vue}\"",
    "lint:fix": "eslint . --fix && prettier --write \"src/**/*.{js,vue}\"",
    "audit": "cargo deny --manifest-path src-tauri/Cargo.toml check && npm audit --omit=dev --audit-level=moderate",
    "types:tsc": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@mdi/font": "^7.4.47",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@vue/devtools-api": "^8.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1",
    "vuetify": "^3.13.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.0",
    "vitest-axe": "^0.1.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
