{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StackVo",
  "version": "0.1.0",
  "identifier": "com.stackvo.desktop",
  "build": {
    "beforeDevCommand": "node tools/sidecars.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node tools/sidecars.mjs --verify && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StackVo",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../docs/help": "docs/help"
    },
    "externalBin": [
      "binaries/stackvo",
      "binaries/stackvo-mcp"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Docker-based local development environment manager",
    "longDescription": "StackVo Desktop manages Docker-based local development environments from the host, without running the dashboard itself as a container.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "createUpdaterArtifacts": true,
    "copyright": "© 2026 Fahrettin Aksoy",
    "publisher": "Fahrettin Aksoy"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/stackvo/stackvo/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCREI0OEZEOEM4QTFFM0IKUldRN0hvcU0vVWpibTVnU3JqTVBEWHJxN1hCUTZzQXNVbnNUcU1ucnI2Wmk0Tnc4RlNPU2wyZGgK"
    }
  }
}
